<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <UseWPF>true</UseWPF>
        <Nullable>enable</Nullable>
        <WindowsSdkPackageVersion>10.0.26100.56</WindowsSdkPackageVersion>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <FileVersion>1.0.0.0</FileVersion>
        <Version>1.0.0.0</Version>
    </PropertyGroup>
    

    <ItemGroup>
      <PackageReference Include="OpenShock.SDK.CSharp.Live" Version="0.0.45" />
      <PackageReference Include="OpenShock.SDK.CSharp" Version="0.0.45" />
      <PackageReference Include="OneOf" Version="3.0.271"/>
      <PackageReference Include="VolcanicArts.VRCOSC.SDK" Version="2026.501.0" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="copy /Y &quot;$(TargetDir)$(TargetName).dll&quot; &quot;%25appdata%25\VRCOSC\packages\local\$(TargetName).dll&quot;"/>
    </Target>

</Project>